{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IDE Configuration Template Profile",
  "description": "Non-secret local preferences used by scripts/ide-setup.py.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "version_timestamp": { "type": "string" },
    "name": { "type": "string" },
    "astra_available": { "type": "boolean", "default": false, "description": "User confirmed Astra access in Codex. Not inferred from a subscription." },
    "opus_available": { "type": "boolean", "default": false, "description": "User confirmed included Opus 5 access on this computer." },
    "fable_available": { "type": "boolean", "default": false, "description": "User confirmed included Fable 5.1 access on this computer." },
    "claude_extra_usage_off": { "type": "boolean", "default": false, "description": "User confirmed extra usage and usage-credit billing disabled. Reconfirm after account or plan changes." },
    "role": { "enum": ["developer", "designer", "writer", "product", "operations", "analyst", "general"] },
    "goals": { "type": "array", "items": { "type": "string" } },
    "stack": { "type": "array", "items": { "type": "string" } },
    "privacy": { "enum": ["public", "internal", "confidential"] },
    "ides": { "type": "array", "items": { "enum": ["codex", "claude", "cursor", "antigravity"] }, "uniqueItems": true },
    "subscriptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chatgpt": { "type": "boolean" },
        "claude": { "type": "boolean" },
        "gemini": { "type": "boolean" },
        "cursor": { "type": "boolean" },
        "openrouter_free": { "type": "boolean" }
      }
    }
  }
}
